{
  "schema_name": "rust_graph_schema",
  "version": 1,
  "description": "Rust-oriented graph JSON schema for rust_from_ast_tool. Designed to express real Rust source, including items, statements, expressions, patterns, and types.",
  "root": {
    "kinds": ["Module", "File"]
  },
  "node_kinds": [
    {"kind": "Module", "role": "root", "children": ["body", "items", "statements"]},
    {"kind": "File", "role": "root", "children": ["body", "items", "statements"]},
    {"kind": "Use", "role": "item", "children": ["path", "tree"]},
    {"kind": "Comment", "role": "comment", "children": []},
    {"kind": "LineComment", "role": "comment", "children": []},
    {"kind": "BlockComment", "role": "comment", "children": []},
    {"kind": "DocComment", "role": "comment", "children": []},
    {"kind": "Struct", "role": "item", "children": ["fields", "body"]},
    {"kind": "Enum", "role": "item", "children": ["variants", "body"]},
    {"kind": "Trait", "role": "item", "children": ["body"]},
    {"kind": "Impl", "role": "item", "children": ["trait", "for", "for_type", "type", "body"]},
    {"kind": "Function", "role": "item", "children": ["params", "args", "return_type", "ret", "generics", "where", "body"]},
    {"kind": "Fn", "role": "item", "children": ["params", "args", "return_type", "ret", "generics", "where", "body"]},
    {"kind": "ItemFn", "role": "item", "children": ["params", "args", "return_type", "ret", "generics", "where", "body"]},
    {"kind": "Const", "role": "item", "children": ["type", "ty", "value"]},
    {"kind": "TypeAlias", "role": "item", "children": ["type", "value"]},
    {"kind": "Let", "role": "stmt", "children": ["target", "pattern", "type", "ty", "value"]},
    {"kind": "LetStmt", "role": "stmt", "children": ["target", "pattern", "type", "ty", "value"]},
    {"kind": "If", "role": "stmt", "children": ["test", "condition", "body", "orelse"]},
    {"kind": "IfExpr", "role": "expr", "children": ["test", "condition", "body", "orelse"]},
    {"kind": "Match", "role": "stmt/expr", "children": ["subject", "value", "expr", "arms", "cases"]},
    {"kind": "While", "role": "stmt", "children": ["condition", "test", "body"]},
    {"kind": "Loop", "role": "stmt", "children": ["body"]},
    {"kind": "For", "role": "stmt", "children": ["target", "pattern", "iter", "in", "body"]},
    {"kind": "Break", "role": "stmt", "children": []},
    {"kind": "Continue", "role": "stmt", "children": []},
    {"kind": "Return", "role": "stmt", "children": ["value"]},
    {"kind": "Expr", "role": "stmt", "children": ["value"]},
    {"kind": "ExpressionStatement", "role": "stmt", "children": ["value"]},
    {"kind": "Block", "role": "stmt/expr", "children": ["statements", "body"]},
    {"kind": "Call", "role": "expr", "children": ["func", "callee", "args"]},
    {"kind": "MethodCall", "role": "expr", "children": ["receiver", "target", "args"]},
    {"kind": "BinaryExpr", "role": "expr", "children": ["left", "lhs", "right", "rhs", "op", "operator"]},
    {"kind": "BinaryOp", "role": "expr", "children": ["left", "lhs", "right", "rhs", "op", "operator"]},
    {"kind": "UnaryExpr", "role": "expr", "children": ["value", "expr"]},
    {"kind": "Reference", "role": "expr", "children": ["value", "inner"]},
    {"kind": "Deref", "role": "expr", "children": ["value", "inner"]},
    {"kind": "Cast", "role": "expr", "children": ["expr", "type"]},
    {"kind": "Tuple", "role": "expr/pattern/type", "children": ["elts", "types"]},
    {"kind": "Array", "role": "expr", "children": ["elts"]},
    {"kind": "StructExpr", "role": "expr", "children": ["path", "name", "fields"]},
    {"kind": "FieldAccess", "role": "expr", "children": ["target", "receiver", "field", "name"]},
    {"kind": "Path", "role": "expr/type/pattern", "children": ["segments", "path"]},
    {"kind": "TypePath", "role": "type/expr/pattern", "children": ["segments", "path"]},
    {"kind": "Name", "role": "leaf", "children": ["ctx"]},
    {"kind": "Ident", "role": "leaf", "children": []},
    {"kind": "Literal", "role": "leaf", "children": []},
    {"kind": "Constant", "role": "leaf", "children": []},
    {"kind": "Lit", "role": "leaf", "children": []},
    {"kind": "Pattern", "role": "pattern", "children": []},
    {"kind": "Wildcard", "role": "pattern", "children": []},
    {"kind": "StructPattern", "role": "pattern", "children": ["path", "name", "fields"]},
    {"kind": "TuplePattern", "role": "pattern", "children": ["elts"]},
    {"kind": "OrPattern", "role": "pattern", "children": ["patterns"]},
    {"kind": "FieldInit", "role": "struct_field", "children": ["value", "expr", "target"]},
    {"kind": "Field", "role": "struct_field", "children": ["type", "ty", "value", "pattern"]},
    {"kind": "EnumVariant", "role": "variant", "children": ["fields", "value", "type"]},
    {"kind": "TupleVariant", "role": "variant", "children": ["fields"]},
    {"kind": "StructVariant", "role": "variant", "children": ["fields"]},
    {"kind": "Param", "role": "binding", "children": ["type", "ty", "pattern"]},
    {"kind": "Arg", "role": "binding", "children": ["type", "ty", "pattern"]},
    {"kind": "Parameter", "role": "binding", "children": ["type", "ty", "pattern"]},
    {"kind": "FormalParameter", "role": "binding", "children": ["type", "ty", "pattern"]},
    {"kind": "Receiver", "role": "binding", "children": []},
    {"kind": "TypeParam", "role": "generic", "children": ["bounds", "default"]},
    {"kind": "GenericParam", "role": "generic", "children": ["bounds", "default"]},
    {"kind": "Lifetime", "role": "generic", "children": []},
    {"kind": "WhereClause", "role": "generic", "children": ["predicates"]},
    {"kind": "WherePredicate", "role": "generic", "children": ["bounded_ty", "bounds"]},
    {"kind": "Macro", "role": "expr/item", "children": ["tokens", "args"]}
  ],
  "edge_labels": [
    "body", "items", "statements", "params", "args", "generics", "type_parameters", "where",
    "return_type", "ret", "fields", "variants", "value", "target", "pattern", "test",
    "condition", "subject", "expr", "func", "callee", "receiver", "left", "lhs", "right", "rhs",
    "op", "operator", "iter", "in", "path", "tree", "segments", "types", "type", "ty",
    "bounds", "default", "predicates", "bounded_ty", "arms", "cases", "guard", "field", "name",
    "ctx", "tokens"
  ],
  "attributes": [
    "text", "label", "name", "visibility", "public", "mutable", "mut", "operator", "kind", "value"
  ],
  "conventions": [
    "Nodes are addressed by unique string or numeric ids.",
    "Edges are ordered by optional order; lower order comes first.",
    "body/items/statements are ordered child collections.",
    "text usually holds the printable identifier, literal, comment text, or surface name.",
    "label usually carries the semantic kind when text is used for content.",
    "Comment and DocComment nodes render as // and /// lines, respectively.",
    "Extra attributes such as public/mutable may refine rendering.",
    "This schema is intended to be expressive enough to round-trip common Rust items and control flow, not to model every rustc internal detail."
  ],
  "examples": [
    "040-rust-ast-func-graph.json",
    "041-rust-ast-struct-impl-graph.json"
  ]
}
